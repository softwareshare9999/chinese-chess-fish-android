<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/ui_paper">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_brand"
            android:textSize="12sp"
            android:textColor="@color/ui_muted"
            android:letterSpacing="0.12"
            android:layout_marginTop="24dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_headline"
            android:textSize="36sp"
            android:textColor="@color/ui_ink"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:lineSpacingExtra="4dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_subtitle"
            android:textSize="15sp"
            android:textColor="@color/ui_muted"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_play"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="12dp"
            android:text="@string/home_play"
            android:textSize="18sp"
            android:textStyle="normal"
            android:gravity="start|center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:textColor="@color/white"
            app:backgroundTint="@color/ui_red"
            app:cornerRadius="20dp"
            app:strokeWidth="0dp"
            app:strokeColor="@color/ui_line"
            app:icon="@drawable/ui_board"
            app:iconTint="@color/white"
            app:iconSize="28dp"
            app:iconPadding="22dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_learn"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="12dp"
            android:text="@string/home_manual"
            android:textSize="18sp"
            android:textStyle="normal"
            android:gravity="start|center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:textColor="@color/ui_ink"
            app:backgroundTint="@color/ui_surface"
            app:cornerRadius="20dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/ui_line"
            app:icon="@drawable/manual"
            app:iconTint="@color/ui_red"
            app:iconSize="28dp"
            app:iconPadding="22dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_help"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/home_help"
                android:textSize="16sp"
                android:textColor="@color/ui_ink"
                app:backgroundTint="@color/ui_surface"
                app:cornerRadius="18dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/ui_line"
                app:icon="@drawable/help"
                app:iconTint="@color/ui_muted"
                app:iconSize="22dp"
                app:iconGravity="textStart"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_about"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="@string/home_about"
                android:textSize="16sp"
                android:textColor="@color/ui_ink"
                app:backgroundTint="@color/ui_surface"
                app:cornerRadius="18dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/ui_line"
                app:icon="@drawable/ui_info"
                app:iconTint="@color/ui_muted"
                app:iconSize="22dp"
                app:iconGravity="textStart"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_privacy"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/home_privacy"
            android:textSize="14sp"
            android:textColor="@color/ui_muted"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="18dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/ui_line"
            app:icon="@drawable/ui_info"
            app:iconTint="@color/ui_muted"
            app:iconSize="20dp"
            app:iconGravity="textStart"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_footer"
            android:textSize="12sp"
            android:textColor="@color/ui_muted"
            android:gravity="center"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="12dp"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
