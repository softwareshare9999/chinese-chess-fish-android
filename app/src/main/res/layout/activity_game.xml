<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/constraintlayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/ui_paper">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:id="@+id/game_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageButton
                android:id="@+id/exitbt"
                style="@style/Widget.Chess.Action"
                android:contentDescription="@string/cd_save_and_back"
                android:tooltipText="@string/cd_save_and_back"
                app:srcCompat="@drawable/arrow_back" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/game_title"
                    android:textSize="20sp"
                    android:textColor="@color/ui_ink"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/opponent_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/opponent_computer"
                    android:textSize="11sp"
                    android:textColor="@color/ui_muted" />
            </LinearLayout>
            <ImageButton
                android:id="@+id/optionbt"
                style="@style/Widget.Chess.Action"
                android:contentDescription="@string/cd_settings"
                android:tooltipText="@string/cd_settings"
                app:srcCompat="@drawable/tune" />
        </LinearLayout>
        <com.zfdang.chess.views.FittedChessLayout
            android:id="@+id/chesslayout"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginVertical="4dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:minHeight="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/ui_card"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp">
            <TextView
                android:id="@+id/statustv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/status_wait_red"
                android:textColor="@color/ui_red"
                android:textSize="13sp"
                android:maxLines="2"
                android:ellipsize="end" />
            <ImageButton
                android:id="@+id/choice1bt"
                android:visibility="gone"
                style="@style/Widget.Chess.Action"
                android:contentDescription="@string/cd_choice_1"
                android:tooltipText="@string/cd_choice_1"
                app:srcCompat="@drawable/looks_1" />
            <ImageButton
                android:id="@+id/choice2bt"
                android:visibility="gone"
                style="@style/Widget.Chess.Action"
                android:contentDescription="@string/cd_choice_2"
                android:tooltipText="@string/cd_choice_2"
                app:srcCompat="@drawable/looks_2" />
            <ImageButton
                android:id="@+id/choice3bt"
                android:visibility="gone"
                style="@style/Widget.Chess.Action"
                android:contentDescription="@string/cd_choice_3"
                android:tooltipText="@string/cd_choice_3"
                app:srcCompat="@drawable/looks_3" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="0dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageButton
                    android:id="@+id/newbt"
                    style="@style/Widget.Chess.Action"
                    android:contentDescription="@string/action_new_game"
                    android:tooltipText="@string/action_new_game"
                    app:srcCompat="@drawable/new_window" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/action_new_game"
                    android:textSize="11sp"
                    android:textColor="@color/ui_muted"
                    android:gravity="center" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageButton
                    android:id="@+id/backbt"
                    style="@style/Widget.Chess.Action"
                    android:contentDescription="@string/action_undo"
                    android:tooltipText="@string/action_undo"
                    app:srcCompat="@drawable/arrow_back" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/action_undo"
                    android:textSize="11sp"
                    android:textColor="@color/ui_muted"
                    android:gravity="center" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageButton
                    android:id="@+id/helpbt"
                    style="@style/Widget.Chess.Action"
                    android:contentDescription="@string/action_hint"
                    android:tooltipText="@string/action_hint"
                    app:srcCompat="@drawable/help" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/action_hint"
                    android:textSize="11sp"
                    android:textColor="@color/ui_muted"
                    android:gravity="center" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageButton
                    android:id="@+id/trendsbt"
                    style="@style/Widget.Chess.Action"
                    android:contentDescription="@string/action_trend"
                    android:tooltipText="@string/action_trend"
                    app:srcCompat="@drawable/history" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/action_trend"
                    android:textSize="11sp"
                    android:textColor="@color/ui_muted"
                    android:gravity="center" />
            </LinearLayout>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/morebt"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/tools_expand"
            android:textColor="@color/ui_muted"
            app:backgroundTint="@android:color/transparent"
            app:strokeWidth="0dp" />
        <LinearLayout
            android:id="@+id/advanced_tools"
            android:layout_width="match_parent"
            android:layout_height="156dp"
            android:orientation="vertical"
            android:background="@drawable/ui_card"
            android:padding="8dp"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageButton
                        android:id="@+id/playerbt"
                        style="@style/Widget.Chess.Action"
                        android:contentDescription="@string/action_play_mode"
                        android:tooltipText="@string/action_play_mode"
                        app:srcCompat="@drawable/computer" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/action_play_mode"
                        android:textSize="11sp"
                        android:textColor="@color/ui_muted"
                        android:gravity="center" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageButton
                        android:id="@+id/playerbackbt"
                        style="@style/Widget.Chess.Action"
                        android:contentDescription="@string/action_step_back"
                        android:tooltipText="@string/action_step_back"
                        app:srcCompat="@drawable/arrow_back" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/action_step_back"
                        android:textSize="11sp"
                        android:textColor="@color/ui_muted"
                        android:gravity="center" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageButton
                        android:id="@+id/playerforwardbt"
                        style="@style/Widget.Chess.Action"
                        android:contentDescription="@string/action_computer_move"
                        android:tooltipText="@string/action_computer_move"
                        app:srcCompat="@drawable/arrow_forward" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/action_computer_move"
                        android:textSize="11sp"
                        android:textColor="@color/ui_muted"
                        android:gravity="center" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageButton
                        android:id="@+id/autoplaybt"
                        style="@style/Widget.Chess.Action"
                        android:contentDescription="@string/action_auto_play"
                        android:tooltipText="@string/action_auto_play"
                        app:srcCompat="@drawable/play_circle" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/action_auto_play"
                        android:textSize="11sp"
                        android:textColor="@color/ui_muted"
                        android:gravity="center" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageButton
                        android:id="@+id/playeraltbt"
                        style="@style/Widget.Chess.Action"
                        android:contentDescription="@string/action_alt_moves"
                        android:tooltipText="@string/action_alt_moves"
                        app:srcCompat="@drawable/alt_route" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/action_alt_moves"
                        android:textSize="11sp"
                        android:textColor="@color/ui_muted"
                        android:gravity="center" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageButton
                        android:id="@+id/quickbt"
                        style="@style/Widget.Chess.Action"
                        android:contentDescription="@string/action_move_now"
                        android:tooltipText="@string/action_move_now"
                        app:srcCompat="@drawable/quick" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/action_move_now"
                        android:textSize="11sp"
                        android:textColor="@color/ui_muted"
                        android:gravity="center" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageButton
                        android:id="@+id/importbt"
                        style="@style/Widget.Chess.Action"
                        android:contentDescription="@string/action_import_fen"
                        android:tooltipText="@string/action_import_fen"
                        app:srcCompat="@drawable/import_fen" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/action_import_fen"
                        android:textSize="11sp"
                        android:textColor="@color/ui_muted"
                        android:gravity="center" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageButton
                        android:id="@+id/exportbt"
                        style="@style/Widget.Chess.Action"
                        android:contentDescription="@string/action_export_fen"
                        android:tooltipText="@string/action_export_fen"
                        app:srcCompat="@drawable/export" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/action_export_fen"
                        android:textSize="11sp"
                        android:textColor="@color/ui_muted"
                        android:gravity="center" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageButton
                        android:id="@+id/stophelpbt"
                        style="@style/Widget.Chess.Action"
                        android:contentDescription="@string/action_stop_hint"
                        android:tooltipText="@string/action_stop_hint"
                        app:srcCompat="@drawable/quick" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/action_stop_hint"
                        android:textSize="11sp"
                        android:textColor="@color/ui_muted"
                        android:gravity="center" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="156dp"
            android:orientation="vertical"
            android:background="@drawable/ui_card"
            android:padding="12dp"
            android:id="@+id/history_panel">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/history_title"
                android:text="@string/history_title"
                android:textSize="14sp"
                android:textColor="@color/ui_ink"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <ScrollView
                    android:id="@+id/historyscroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true">
                    <TableLayout
                        android:id="@+id/historyTable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </ScrollView>
                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/trendchart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/history_empty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/history_empty"
                    android:textSize="13sp"
                    android:lineSpacingExtra="8dp"
                    android:textColor="@color/ui_muted" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
