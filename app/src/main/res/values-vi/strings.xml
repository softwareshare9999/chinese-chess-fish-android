    <string name="info_about_title">Giới thiệu Cờ tướng Fish</string>
    <string name="info_privacy_title">Chính sách quyền riêng tư</string>
    <string name="info_help_title">Hướng dẫn sử dụng</string>
    <string name="info_expanded">Đã mở rộng</string>
    <string name="info_collapsed">Đã thu gọn</string>
    <string name="info_no_browser">Không tìm thấy ứng dụng để mở liên kết</string>
    <string name="help_heading">Bắt đầu từ nước đầu tiên</string>
    <string name="help_heading_sub">Mở một chủ đề để hiểu cách chơi, phân tích và xem kỳ phổ.</string>
    <string name="help_play_title">Bắt đầu một ván</string>
    <string name="help_play_body">Vào «Đối trận», chạm quân cờ rồi chạm ô đích để đi. Các ô hợp lệ sẽ được đánh dấu trên bàn.\n\n«Ván mới» bắt đầu lại, «Đi lại» quay về nước trước. «Cài đặt đối trận» ở góc phải trên để đổi bên đi trước, nước của máy và cách tìm kiếm.</string>
    <string name="help_hint_title">Gợi ý và nước ứng viên</string>
    <string name="help_hint_body">Khi đến lượt bên Đỏ, chạm «Gợi ý». Engine sẽ đưa ra nước ứng viên và vẽ mũi tên trên bàn. Chạm nút ứng viên để chọn, hoặc đi quân trực tiếp trên bàn.\n\nMuốn đổi nước của máy, hãy mở «Công cụ engine và bàn cờ» rồi chọn «Nước ứng viên».</string>
    <string name="help_search_title">Tìm kiếm và Đi ngay</string>
    <string name="help_search_body">Theo độ sâu: ra nước khi đạt độ sâu đã đặt; độ sâu càng cao thường càng lâu.\n\nTheo thời gian: tìm trong khoảng thời gian đã đặt, phù hợp khi muốn kiểm soát thời gian chờ mỗi nước.\n\nTìm liên tục: phân tích không dừng, cần chạm «Đi ngay» trong khu công cụ để kết thúc và lấy kết quả. Nếu tìm quá chậm, hãy giảm độ sâu hoặc rút ngắn thời gian.</string>
    <string name="help_fen_title">Thế cờ FEN và đánh giá</string>
    <string name="help_fen_body">Mở «Công cụ engine và bàn cờ» để bắt đầu từ chuỗi FEN, hoặc xuất FEN của thế hiện tại để chia sẻ, xem lại hay báo lỗi.\n\n«Đánh giá» phân tích thế hiện tại, «Xu thế» xem các đánh giá đã có. Thế chưa đánh giá sẽ không hiện điểm 0.</string>
    <string name="help_manual_title">Mở kỳ phổ</string>
    <string name="help_manual_body">Vào «Xem kỳ phổ», chạm nút mở để chọn kỳ phổ XQF có sẵn. Dùng tiến/lùi để duyệt nước đi; nếu có nhiều nhánh, hãy chọn nhánh muốn xem.\n\nChạm nút đối trận để chơi từ thế cờ hiện tại của kỳ phổ. Quay lại vẫn có thể tiếp tục xem kỳ phổ.</string>
    <string name="help_engine_title">Cài đặt engine và chọn phiên bản</string>
    <string name="help_engine_body">Hash là bộ nhớ đệm tìm kiếm của engine. Hãy đặt theo RAM điện thoại; bộ đệm quá lớn có thể khiến hệ thống dừng engine.\n\nBật nước đi ngẫu nhiên thì máy sẽ chọn trong các nước ứng viên ở giai đoạn khai cuộc, làm ván đa dạng hơn nhưng có thể giảm lực cờ. Bên đi trước có hiệu lực ở ván mới.\n\nPhiên bản ARMv8 dành cho điện thoại ARM64 được hỗ trợ; bản dotprod cần CPU hỗ trợ lệnh tích vô hướng. Nếu không chắc, hãy chọn bản ARMv8 thường.</string>
    <string name="help_feedback_title">Báo lỗi</string>
    <string name="help_feedback_body">Hãy kèm các bước tái hiện, mẫu điện thoại, phiên bản ứng dụng; nếu liên quan đến ván cờ, hãy kèm cả FEN đã xuất. Liên kết bên dưới mở trang báo lỗi của dự án trong trình duyệt.</string>
    <string name="about_heading">Cờ tướng Fish</string>
    <string name="about_heading_sub">CHESS FISH\nCông cụ học cờ tướng mã nguồn mở, miễn phí</string>
    <string name="about_intro_title">Một ván cờ, chơi từ từ.</string>
    <string name="about_intro_body">Đối đầu engine Pikafish, xem nước ứng viên và đánh giá thế trận, hoặc mở một kỳ phổ để ôn lại ván hay.</string>
    <string name="about_version_title">Thông tin phiên bản</string>
    <string name="about_version_body">Phiên bản ứng dụng  %1$s · %2$d\nEngine Pikafish và NNUE  %3$s</string>
    <string name="about_credits_title">Mã nguồn mở và lời cảm ơn</string>
    <string name="about_credits_body">Do zfdang duy trì.\n\nEngine cờ tướng đến từ Pikafish; mã giao tiếp engine dựa trên DroidFish. Cảm ơn các dự án mã nguồn mở và người đóng góp. Mã nguồn và giấy phép liên quan có trong kho dự án.</string>
